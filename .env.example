# PostgreSQL superuser connection used only by migrate and seed scripts.
# This user must be allowed to create extensions, roles, and bypass row level security.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/marie_learning

# Application connection. The migrate script creates the marie_app role.
# Use the same password as APP_DB_PASSWORD.
DATABASE_URL=postgresql://marie_app:replace-with-a-long-password@localhost:5432/marie_learning

# Password for the non-superuser application role. Letters, numbers, and symbols are fine.
APP_DB_PASSWORD=replace-with-a-long-password

# At least 32 random characters. Used to sign login cookies.
SESSION_SECRET=replace-with-a-random-string-at-least-32-characters

# First instructor account. Created by npm run db:seed if the email does not exist.
INSTRUCTOR_EMAIL=instructor@marie.local
INSTRUCTOR_PASSWORD=change-this-instructor-password
INSTRUCTOR_NAME=Programme Instructor
INSTRUCTOR_TIMEZONE=UTC

# Set to true to allow students to open /register and create their own accounts.
ALLOW_STUDENT_REGISTRATION=true

# Optional local student used to try the student experience. Created only when true.
SEED_DEMO_STUDENT=false
DEMO_STUDENT_EMAIL=student@marie.local
DEMO_STUDENT_PASSWORD=change-this-student-password
DEMO_STUDENT_NAME=Demo Student

# Overwrite curriculum rows that an instructor has edited.
SEED_FORCE=false

# Reset instructor and demo student passwords from this file on the next seed.
SEED_RESET_PASSWORDS=false

# Optional. If set, forgotten-password emails are sent with Resend (https://resend.com).
# RESEND_API_KEY=
# EMAIL_FROM="Marie Learning <learn@example.com>"

# Optional public site URL used in password-reset links. No trailing slash.
# APP_URL=http://localhost:3000
